# Copy to .env and fill in. .env is gitignored.

# Required for the LLM extractor (get one at https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# SEC EDGAR requires a descriptive User-Agent with a contact email on every request.
# See https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT=edse-research your.name@example.com
