# Copy to .env and fill in. .env is gitignored.

# REQUIRED. SEC EDGAR needs a descriptive User-Agent with a contact email on every
# request; anonymous clients are blocked and the failure is silent (empty results),
# so the code refuses to start without this.
# See https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT=edse-research your.name@example.com

# OPTIONAL. Only for `edse extract --extractor claude`. The default extractor is a
# local qwen2.5:7b via Ollama, and the entire pipeline -- every figure and metric in
# the README -- was produced with no key set. Leave this commented out unless you
# specifically want the hosted path. https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
